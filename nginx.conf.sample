server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name tnhub.kr www.tnhub.kr;

    # Let's Encrypt 인증을 위한 설정
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # HTTP -> HTTPS 리디렉션
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl ipv6only=on;

    server_name tnhub.kr www.tnhub.kr;

    # SSL 인증서 설정 (기존 설정 유지)
    ssl_certificate /etc/letsencrypt/live/tnhub.kr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tnhub.kr/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # 기본 보안 헤더
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # 1. React Frontend (정적 파일 서빙)
    # Jenkins가 /var/www/html 경로에 빌드된 파일을 복사해둡니다.
    root /var/www/html;
    index index.html;

    location / {
        # SPA 라우팅 지원: 파일이 없으면 index.html을 보여줌
        try_files $uri $uri/ /index.html;
    }

    # index.html은 캐시하지 않음 → 배포 직후 사용자가 예전 화면(예전 JS 번들)에 머무르지 않도록
    # (/assets/* 는 파일명에 해시가 붙어 있어 캐시해도 안전)
    location = /index.html {
        add_header Cache-Control "no-cache" always;
    }

    # 2. Spring Boot Backend (API 프록시)
    # /api/ 로 시작하는 요청은 백엔드(8080 포트)로 보냅니다.
    # ⚠️ 중요: proxy_pass에 trailing slash(/)를 붙이지 않아야 /api 경로가 유지됩니다.
    location /api/ {
        proxy_pass http://localhost:8080;
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 관리자 API는 /api/admin/** 로 이동했으므로 /admin/ 은 React 페이지로 처리 (별도 프록시 없음)

    # 3. OAuth2 로그인 프록시
    location /oauth2/ {
        proxy_pass http://localhost:8080;
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 4. 로그인/로그아웃 프록시
    # /login 페이지(GET)는 React가 처리하고, 로그인 요청(POST)만 백엔드로 보냄
    location = /login {
        error_page 418 = @backend;
        if ($request_method = POST) {
            return 418;
        }
        try_files /index.html =404;
    }

    # OAuth2 콜백(/login/oauth2/code/*) 및 로그아웃은 백엔드로
    location ~ ^/(login/oauth2/|logout) {
        proxy_pass http://localhost:8080;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location @backend {
        proxy_pass http://localhost:8080;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 5. WebSocket 프록시 (채팅 기능)
    # wss:// (WebSocket Secure) 연결을 위한 설정
    # ⚠️ 중요: SockJS는 /ws-chat/info, /ws-chat/123/abc/websocket 등 하위 경로를 사용하므로
    # trailing slash(/)를 반드시 포함해야 합니다.
    location /ws-chat/ {
        proxy_pass http://localhost:8080;
        
        # WebSocket 업그레이드를 위한 헤더
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        
        # 기본 프록시 헤더
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # WebSocket 타임아웃 설정 (1시간)
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # 6. 파일 업로드/다운로드/표시 프록시
    location ~ ^/(uploadAjax|removeFile|upload|download|display) {
        proxy_pass http://localhost:8080;
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # 파일 업로드 크기 제한 (1GB)
        client_max_body_size 1024M;
        
        # 대용량 파일 업로드 타임아웃 (10분)
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }
}
